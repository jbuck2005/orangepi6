From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: orangepi6 kernel-7 port
Subject: [PATCH] DEBUG log each step of the reboot path

Debug aid for the 7.3.5 warm-reboot hang: log before EFI ResetSystem,
if it returns, before the restart handlers, and in the PSCI system reset
handler. Together with initcall_debug (one line per device shutdown and
syscore callback) this shows where the reboot stops. Drop once the hang
is fixed.
---
 arch/arm64/kernel/process.c  | 6 +++++-
 drivers/firmware/psci/psci.c | 2 ++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kernel/process.c b/arch/arm64/kernel/process.c
index 42b15b0c0..3a1465daf 100644
--- a/arch/arm64/kernel/process.c
+++ b/arch/arm64/kernel/process.c
@@ -137,10 +137,14 @@ void machine_restart(char *cmd)
 	 * UpdateCapsule() depends on the system being reset via
 	 * ResetSystem().
 	 */
-	if (efi_enabled(EFI_RUNTIME_SERVICES))
+	if (efi_enabled(EFI_RUNTIME_SERVICES)) {
+		pr_emerg("reboot: calling EFI ResetSystem (mode %d)\n", reboot_mode);
 		efi_reboot(reboot_mode, NULL);
+		pr_emerg("reboot: EFI ResetSystem returned\n");
+	}
 
 	/* Now call the architecture specific reboot code. */
+	pr_emerg("reboot: calling restart handlers\n");
 	do_kernel_restart(cmd);
 
 	/*
diff --git a/drivers/firmware/psci/psci.c b/drivers/firmware/psci/psci.c
index e73bae6cb..bb89cd1ff 100644
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -309,6 +309,8 @@ static int get_set_conduit_method(const struct device_node *np)
 static int psci_sys_reset(struct notifier_block *nb, unsigned long action,
 			  void *data)
 {
+	pr_emerg("reboot: PSCI system reset (mode %d, reset2 %d)\n",
+		 reboot_mode, psci_system_reset2_supported);
 	if ((reboot_mode == REBOOT_WARM || reboot_mode == REBOOT_SOFT) &&
 	    psci_system_reset2_supported) {
 		/*
