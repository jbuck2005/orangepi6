 drivers/media/platform/cix/if/v4l2/mvx_ext_v4l2.c  |  3 +-
 drivers/misc/armchina-npu/sky1/sky1.c              | 11 ++-----
 drivers/usb/host/xhci-plat.c                       |  3 +-
 14 files changed, 78 insertions(+), 83 deletions(-)

