+			if (v >= 0x90000000 && v < 0xC0000000 &&
+			    !aipu_mm_v3_dbg_iova_phys(mm, v)) {
+				v3dbg(mm, "PTRSCAN %-4s %s base=0x%llx +0x%x = 0x%x (m0 dangling)\n",
+				      tag, field, base, poff + w, v);
+				hits++;
+			}
+		}
+	}
+}
