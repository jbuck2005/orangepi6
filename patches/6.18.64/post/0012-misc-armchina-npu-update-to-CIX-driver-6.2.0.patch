 		if (!copy_from_user(&desc, (struct buf_desc __user *)arg, sizeof(desc)))
 			ret = aipu_mm_cache_invalid(&aipu->mm, &desc);
@@ -460,6 +559,3 @@ int armchina_aipu_free_dma_buf(int fd)
