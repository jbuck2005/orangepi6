From: jbuck2005 <59450931+jbuck2005@users.noreply.github.com>
Subject: [PATCH] PCI: sky1: take the NIC ports down on a reboot

A warm reboot from this kernel leaves the x2/x1 controllers (the two
RTL8125 ports) in a state the firmware's link training cannot start from:
both ports end in Polling.Compliance (LTSSM 0x40C80) until the board loses
power. Ruled out on the board: PERST# alone, the shutdown hooks (SysRq-b
fails too), ASPM, the NIC config, and the RCSU strap words, which match
the firmware's. A boot whose links never came up does not do it, so it is
state the driver's controller and PHY bring-up leaves running.

Add a platform .shutdown that, on SYSTEM_RESTART, takes each such port
down like the suspend path does: PME_Turn_Off, stop link training, link
disable, PERST#, PHY power off and exit, controller clocks off, endpoint
power off. That is the closest to a cold start. The syscore hook then
skips those ports, whose registers are no longer clocked.

"sky1_pcie_reboot_reset=0" turns this off, 1 (default) does the x2/x1
ports, 2 does all ports.

---
--- a/drivers/pci/controller/cadence/pci-sky1.c
+++ b/drivers/pci/controller/cadence/pci-sky1.c
@@ -2491,7 +2491,7 @@ static void sky1_pcie_dump_rcsu(struct sky1_pcie *pcie, const char *when);
 
 static int _sky1_pcie_syscore_op_shutdown(struct sky1_pcie *pcie)
 {
-	if (!pcie->is_probe)
+	if (!pcie->is_probe || pcie->reboot_down)
 		return 0;
 
 	if (system_state == SYSTEM_RESTART)
@@ -3068,9 +3068,56 @@ static int sky1_pcie_resume_noirq(struct device *dev)
 const struct dev_pm_ops sky1_pcie_pm_ops = { SET_NOIRQ_SYSTEM_SLEEP_PM_OPS(
 	sky1_pcie_suspend_noirq, sky1_pcie_resume_noirq) };
 
+/*
+ * A warm reboot from this kernel leaves the controllers and PHYs of ports
+ * with a trained link in a state the firmware's link training cannot start
+ * from: both RTL8125 ports end in Polling.Compliance until the board loses
+ * power. A boot whose links never came up does not do this, and neither does
+ * a kernel that leaves the firmware's setup alone. So on a reboot take each
+ * port down the way the suspend path does (PME_Turn_Off, link disable,
+ * PERST#, PHY off, clocks off), which is the closest to a cold start.
+ *
+ * sky1_pcie_reboot_reset=0 turns this off, 1 (default) does it for the
+ * x2/x1 ports (the NICs), 2 for all ports.
+ */
+static unsigned int sky1_pcie_reboot_reset = 1;
+
+static int __init sky1_pcie_reboot_reset_setup(char *str)
+{
+	return kstrtouint(str, 0, &sky1_pcie_reboot_reset) == 0;
+}
+__setup("sky1_pcie_reboot_reset=", sky1_pcie_reboot_reset_setup);
+
+static void sky1_pcie_shutdown(struct platform_device *pdev)
+{
+	struct sky1_pcie *pcie = platform_get_drvdata(pdev);
+
+	if (!pcie || !pcie->is_probe || system_state != SYSTEM_RESTART)
+		return;
+	if (sky1_pcie_reboot_reset == 0 ||
+	    (sky1_pcie_reboot_reset == 1 && !sky1_pcie_is_x211(pcie)))
+		return;
+
+	sky1_pcie_dump_rcsu(pcie, "reboot");
+	sky1_pcie_disable_irq(pcie);
+	sky1_pcie_pme_turn_off(pcie);
+	sky1_pcie_stop_link(pcie->cdns_pcie);
+	sky1_pcie_set_link_disable(pcie);
+	sky1_pcie_reset_ep_assert(pcie);
+	phy_power_off(pcie->pcie_phy);
+	phy_exit(pcie->pcie_phy);
+	sky1_pcie_ctrl_set_axi_clk_en(pcie, false);
+	sky1_pcie_ctrl_set_apb_clk_en(pcie, false);
+	if (!pcie->str_pwron)
+		sky1_pcie_en_ep_power(pcie, false);
+	pcie->reboot_down = true;
+	dev_info(&pdev->dev, "reboot: port taken down\n");
+}
+
 static struct platform_driver sky1_pcie_driver = {
 	.probe  = sky1_pcie_probe,
 	.remove = sky1_pcie_remove,
+	.shutdown = sky1_pcie_shutdown,
 	.driver = {
 		.name	= "sky1-pcie",
 		.of_match_table = of_sky1_pcie_match,
--- a/drivers/pci/controller/cadence/pci-sky1.h
+++ b/drivers/pci/controller/cadence/pci-sky1.h
@@ -148,6 +148,7 @@ struct sky1_pcie {
 	bool is_aer_uncor_panic;
 	bool str_pwron;
 	bool std_pwron;
+	bool reboot_down;	/* torn down by sky1_pcie_shutdown() */
 	u32 aer_c_irq;
 	u32 aer_f_irq;
 	u32 aer_nf_irq;
