From: jbuck2005 <59450931+jbuck2005@users.noreply.github.com>
Subject: [PATCH] PCI: sky1: (debug) log the refclk strap register at probe

The driver sets refclk strap bits (external refclk detect, termination,
digital divider) that the firmware may not reprogram after a warm reset.
If they survive the reset, the firmware's link training can run with the
wrong reference clock setup, which would fit a link stuck in Polling.

Log the register before and after the driver writes it. After a cold
boot the "before" value is the firmware's; after a warm reboot from this
kernel it shows whether the old value survived. Read-only, no behaviour
change.

---
--- a/drivers/pci/controller/cadence/pci-sky1.c
+++ b/drivers/pci/controller/cadence/pci-sky1.c
@@ -1904,6 +1904,7 @@ static void sky1_pcie_set_refclk(struct sky1_pcie *pcie, bool en)
 	static atomic_t x211_refclk_enable_cnt = ATOMIC_INIT(0);
 	u32 mask = 0, value = 0;
 	void __iomem *strap_addr = NULL;;
+	u32 strap_before = 0;
 
 	/* set ext_refclk_detected_cfg */
 	mask |= EXT_REFCLK_DETECTED_CFG;
@@ -1922,6 +1923,7 @@ static void sky1_pcie_set_refclk(struct sky1_pcie *pcie, bool en)
 	case PCIE_ID_x8:
 	case PCIE_ID_x4:
 		strap_addr = pcie->strap_base + STRAP_REG(8);
+		strap_before = readl(strap_addr);
 		if (en)
 			sky1_pcie_update_bits32(strap_addr, mask, value);
 		else
@@ -1932,6 +1934,7 @@ static void sky1_pcie_set_refclk(struct sky1_pcie *pcie, bool en)
 	case PCIE_ID_x1_1:
 		strap_addr = pcie->rcsu_base + APP_OFFSET_STRAP_REG + STRAP_REG(40);
 		mutex_lock(&sky1_init_mutex);
+		strap_before = readl(strap_addr);
 		if (en) {
 			sky1_pcie_update_bits32(strap_addr, mask, value);
 			atomic_inc(&x211_refclk_enable_cnt);
@@ -1945,6 +1948,11 @@ static void sky1_pcie_set_refclk(struct sky1_pcie *pcie, bool en)
 	default:
 		break;
 	}
+
+	/* Debug: shows whether a warm reset kept the previous kernel's value. */
+	if (en && strap_addr)
+		dev_info(pcie->dev, "refclk strap %08x -> %08x\n", strap_before,
+			 readl(strap_addr));
 }
 
 static void sky1_pcie_set_l0s_disable(struct sky1_pcie *pcie)
